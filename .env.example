# demo никогда не обращается к внешним сервисам
CRM_MODE=demo
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_MODEL=openai/gpt-4o-mini
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_SPREADSHEET_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для live HTTP endpoint нужен случайный токен длиной не менее 32 символов
CRM_TRIGGER_TOKEN=
HOT_LEAD_THRESHOLD=70
MAX_LEADS_PER_RUN=5
AI_TIMEOUT_SECONDS=45
# Защита от затрат: live обработка выключена до явного включения
LIVE_PROCESSING_ENABLED=false
